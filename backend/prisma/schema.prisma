generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  POLICY_CREATED
  POLICY_UPDATED
  POLICY_DELETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdClaims Claim[] @relation("ClaimCreatedBy")
  updatedClaims Claim[] @relation("ClaimUpdatedBy")
}

model Customer {
  id          String  @id @default(uuid())
  name        String
  companyName String?
  email       String  @unique
  phone       String
  password    String

  // Customer Group fields
  groupCode      String? @unique
  groupName      String?
  category       String? // Client, Others, personal, etc.
  // Contact Info
  mobilePersonal String?
  emailPersonal  String?
  mobileBusiness String?
  emailBusiness  String?

  // Preferred Communication Address
  prefCommAddress String? // "Residence" | "Office"

  // Residence Address
  resAddressLine1 String?
  resAddressLine2 String?
  resAddressLine3 String?
  resAddressLine4 String?
  resCity         String?
  resPin          String?
  resState        String?
  resCountry      String? @default("India")
  resArea         String?

  // Office Address
  offAddressLine1 String?
  offAddressLine2 String?
  offAddressLine3 String?
  offAddressLine4 String?
  offCity         String?
  offPin          String?
  offState        String?
  offCountry      String? @default("India")
  offArea         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         CustomerMaster[]
  policies        Policy[]
  familyHistories FamilyHistory[]
}

// ======================================================
// Insurance Provider Master
// Example: LIC, HDFC Life, SBI Life, ICICI Prudential
// ======================================================

model InsuranceProvider {
  id          String  @id @default(uuid())
  type        String // Insurance, Bank, Investment
  name        String
  code        String  @unique // LIC, HDFC_LIFE, SBI_LIFE
  description String?
  isActive    Boolean @default(true)

  categories ProductCategory[]
  products   ProductMaster[]

  advisors Advisor[]
  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Claim {
  id            String   @id @default(cuid())
  policyId      String
  claimantName  String
  claimType     String   // e.g., 'Death', 'Maturity', 'Rider', 'Other'
  claimAmount   Float
  status        String   @default("Pending") // e.g., 'Pending', 'Approved', 'Rejected', 'In Progress'
  claimDate     DateTime
  reasonForClaim String?
  
  // Relations
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  
  createdBy     User     @relation("ClaimCreatedBy", fields: [createdById], references: [id])
  createdById   String
  updatedBy     User?    @relation("ClaimUpdatedBy", fields: [updatedById], references: [id])
  updatedById   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


// ======================================================
// Product Category Master
// Example:
// Life Insurance
// Health Insurance
// Motor Insurance
// Mutual Fund
// ======================================================

model ProductCategory {
  id         String @id @default(uuid())
  providerId String

  categoryName String
  categoryCode String  @unique
  description  String?

  isActive Boolean @default(true)

  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  products ProductMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// Product Master
// Example:
// Jeevan Anand
// Jeevan Labh
// Click2Protect
// ======================================================

model ProductMaster {
  id String @id @default(uuid())

  providerId String
  categoryId String

  productName String
  productCode String

  planNumber String?

  productType String?
  description String?

  isActive Boolean @default(true)

  provider InsuranceProvider @relation(fields: [providerId], references: [id])
  category ProductCategory   @relation(fields: [categoryId], references: [id])

  attributes ProductAttributeValue[]
  policies   Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, productCode])
}

// ======================================================
// Product Attribute Master
// Defines configurable product attributes
// ======================================================

model ProductAttributeMaster {
  id String @id @default(uuid())

  attributeName String
  attributeCode String @unique

  dataType String // Text, Number, Date, Boolean, Dropdown

  isRequired Boolean @default(false)
  isActive   Boolean @default(true)

  values           ProductAttributeValue[]
  options          ProductAttributeOption[]
  policyAttributes PolicyAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// Product Attribute Values
// Stores values of attributes for each product
// ======================================================

model ProductAttributeValue {
  id String @id @default(uuid())

  productId   String
  attributeId String

  value String

  product   ProductMaster          @relation(fields: [productId], references: [id])
  attribute ProductAttributeMaster @relation(fields: [attributeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeId])
}

model PolicyStatusMaster {
  id          String  @id @default(uuid())
  statusName  String
  statusCode  String  @unique
  description String?
  isActive    Boolean @default(true)

  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PremiumModeMaster {
  id          String  @id @default(uuid())
  modeName    String
  modeCode    String  @unique
  months      Int?
  description String?

  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiderMaster {
  id          String  @id @default(uuid())
  riderName   String
  riderCode   String  @unique
  description String?
  isActive    Boolean @default(true)

  policyRiders PolicyRider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Policy {
  id String @id @default(uuid())

  clientId         String
  CustomerMasterId String
  providerId       String
  productId        String

  statusId      String
  premiumModeId String

  advisorId      String?
  branchId       String?

  policyNumber   String  @unique
  proposalNumber String?

  issueDate        DateTime?
  commencementDate DateTime
  maturityDate     DateTime?

  policyTerm        Int?
  premiumPayingTerm Int?

  nextPremiumDueDate DateTime?

  agentCode  String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer       Customer           @relation(fields: [clientId], references: [id])
  CustomerMaster CustomerMaster     @relation(fields: [CustomerMasterId], references: [id])
  provider       InsuranceProvider  @relation(fields: [providerId], references: [id])
  product        ProductMaster      @relation(fields: [productId], references: [id])
  status         PolicyStatusMaster @relation(fields: [statusId], references: [id])
  premiumMode    PremiumModeMaster  @relation(fields: [premiumModeId], references: [id])

  advisor Advisor? @relation(fields: [advisorId], references: [id])
  branch LicBranch? @relation(fields: [branchId], references:[id])

  nominees     Nominee[]
  policyRiders PolicyRider[]
  documents    PolicyDocument[]
  premium      PolicyPremiumCalculation?

  policyAttributes PolicyAttribute[]
  premiumPayments  PremiumPayment[]
  loans            PolicyLoan[]
  claims  Claim[]

  notifications Notification[]
}

model Notification {
  id        String           @id @default(uuid())

  title     String
  message   String
  type      NotificationType

  isRead    Boolean          @default(false)

  policyId  String?
  policy    Policy?          @relation(fields: [policyId], references: [id], onDelete: SetNull)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([createdAt])
}

model PolicyAttribute {
  id String @id @default(uuid())

  policyId    String
  attributeId String

  value String

  policy    Policy                 @relation(fields: [policyId], references: [id])
  attribute ProductAttributeMaster @relation(fields: [attributeId], references: [id])

  @@unique([policyId, attributeId])
}

model PolicyRider {
  id String @id @default(uuid())

  policyId String
  riderId  String

  riderAmount  Decimal?
  riderPremium Decimal?

  policy Policy      @relation(fields: [policyId], references: [id])
  rider  RiderMaster @relation(fields: [riderId], references: [id])

  @@unique([policyId, riderId])
}

model Nominee {
  id String @id @default(uuid())

  policyId String

  nomineeName  String
  relationship String
  dateOfBirth  DateTime?
  percentage   Decimal?

  phone   String?
  email   String?
  address String?

  policy Policy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PremiumPayment {
  id String @id @default(uuid())

  policyId String

  installmentNo Int?

  dueDate  DateTime
  paidDate DateTime?

  premiumAmount Decimal
  lateFee       Decimal?

  paymentMode String?

  receiptNumber String?

  paymentStatusId String

  paymentStatus PaymentStatusMaster @relation(fields: [paymentStatusId], references: [id])

  policy Policy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyLoan {
  id String @id @default(uuid())

  policyId String

  loanNumber String?
  loanAmount Decimal
  interestRate Decimal?
  loanDate DateTime

  loanTenure Int?
  remarks String?

  loanStatusId String

  loanStatus LoanStatusMaster @relation(fields: [loanStatusId], references: [id])

  policy Policy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyDocument {
  id String @id @default(uuid())

  policyId String

  documentName String
  documentType String

  filePath String

  policy Policy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// Advisor Master
// Insurance Advisor / Agent
// ======================================================

model Advisor {
  id String @id @default(uuid())

  providerId String

  advisorCode String
  advisorName String

  agencyId    String?
  agency      Agency? @relation(fields: [agencyId], references: [id])

  email String?
  phone String?

  licenseNumber String?
  panNumber     String?

  designation String?
  joiningDate DateTime?

  isActive Boolean @default(true)

  provider InsuranceProvider @relation(fields: [providerId], references: [id])

  policies Policy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, advisorCode])
}

model PolicyPremiumCalculation {
  id String @id @default(uuid())

  policyId String @unique

  sumAssured Decimal

  basicYearlyPremium Decimal
  totalYearlyPremium Decimal

  installmentPremium Decimal

  gst Decimal?

  extraClass Decimal?

  rebate Decimal?

  totalInstallmentPremium Decimal

  policy Policy @relation(fields: [policyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentStatusMaster {
  id String @id @default(uuid())

  statusName String
  statusCode String @unique

  payments PremiumPayment[]
}

model LoanStatusMaster {
  id String @id @default(uuid())

  statusName String
  statusCode String @unique

  loans PolicyLoan[]
}

model ProductAttributeOption {
  id String @id @default(uuid())

  attributeId String

  optionLabel String
  optionValue String?

  displayOrder Int?
  isDefault    Boolean @default(false)
  isActive     Boolean @default(true)

  attribute ProductAttributeMaster @relation(fields: [attributeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, optionLabel])
}

model CustomerMaster {
  id               String    @id @default(uuid())
  groupId          String?
  salutation       String?
  firstName        String
  middleName       String?
  lastName         String
  gender           String?
  dob              DateTime?
  isGroupHead      Boolean   @default(false)
  customerType     String? // INDIVIDUAL, CORPORATE, etc.
  panNumber        String?
  aadhaarNumber    String?
  guardianId       String?
  salutationLetter String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  group       Customer?                   @relation(fields: [groupId], references: [id])
  guardian    CustomerMaster?             @relation("GuardianRelation", fields: [guardianId], references: [id])
  dependents  CustomerMaster[]            @relation("GuardianRelation")
  contactInfo CustomerContactInfo?
  addresses   CustomerAddress[]
  bankDetails CustomerBankDetails[]
  miscInfo    CustomerMiscInfo?
  preferences     CustomerServicePreferences?
  policies        Policy[]
  familyHistories FamilyHistory[]
  medicalHistories MedicalHistory[]
}

model CustomerContactInfo {
  id              String   @id @default(uuid())
  customerId      String   @unique
  mobile1         String?
  mobile2         String?
  landline1Std    String?
  landline1Number String?
  landline2Std    String?
  landline2Number String?
  faxStd          String?
  faxNumber       String?
  emailPersonal   String?
  emailBusiness   String?
  skypeId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id              String   @id @default(uuid())
  customerId      String
  addressType     String // "Residence" | "Office" | etc.
  addressLine1    String?
  addressLine2    String?
  addressLine3    String?
  addressLine4    String?
  city            String?
  pin             String?
  country         String?  @default("India")
  state           String?
  area            String?
  useGroupAddress Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerBankDetails {
  id            String   @id @default(uuid())
  customerId    String
  isDefault     Boolean  @default(false)
  ifscCode      String?
  bankName      String?
  bankBranch    String?
  city          String?
  accountType   String?
  accountNumber String?
  micrNumber    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerMiscInfo {
  id                 String    @id @default(uuid())
  customerId         String    @unique
  relationToGroup    String?
  dobForGreetings    DateTime?
  marriageDate       DateTime?
  isMarried          Boolean   @default(false)
  demiseDate         DateTime?
  isDead             Boolean   @default(false)
  fatherName         String?
  motherName         String?
  spouseName         String?
  nationality        String?   @default("Indian")
  qualification      String?
  occupationType     String?
  occupation         String?
  employer           String?
  natureOfDuties     String?
  referredBy         String?
  heightFt           String?
  weightKg           String?
  incomeSlab         String?
  religion           String?
  crmGroups          String?
  passportNumber     String?
  passportExpiryDate DateTime?
  gstNumber          String?
  specialNote        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerServicePreferences {
  id                   String   @id @default(uuid())
  customerId           String   @unique
  preferredCommAddress String?
  smsMarketing         Boolean  @default(true)
  emailMarketing       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  customer CustomerMaster @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model LicBranch {
  id          String   @id @default(cuid())
  branchCode  String   @unique
  branchName  String
  division    String?
  address        String?
  state       String?
  pincode        String?

  policies    Policy[]
  agencies    Agency[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agency {
  id           String   @id @default(cuid())
  agencyCode   String   @unique
  agencyName   String
  licenseNo    String?

  branchId     String?
  branch       LicBranch? @relation(fields: [branchId], references: [id])

  address      String?
  contactNo    String?
  email        String?
  isActive     Boolean  @default(true)

  advisors     Advisor[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model FamilyHistory {
  id        String                @id @default(uuid())
  groupId   String
  memberId  String
  date      DateTime              @default(now())
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  group     Customer              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    CustomerMaster        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  records   FamilyHistoryRecord[]
}

model FamilyHistoryRecord {
  id              String        @id @default(uuid())
  familyHistoryId String
  relation        String
  age             Int
  stateOfHealth   String
  isDead          Boolean       @default(false)
  ageAtDeath      Int?
  causeOfDeath    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  familyHistory   FamilyHistory @relation(fields: [familyHistoryId], references: [id], onDelete: Cascade)
}

model MedicalHistory {
  id        String                 @id @default(uuid())
  memberId  String
  date      DateTime               @default(now())
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  member  CustomerMaster        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  records MedicalHistoryRecord[]
}

model MedicalHistoryRecord {
  id              String        @id @default(uuid())
  medicalHistoryId String

  // Basic details
  medicalHistoryDate DateTime     @default(now())
  age              Int? // derived from member DOB, read-only in UI
  gender           String? // derived from member profile, read-only in UI

  // Member's details
  bloodGroup       String // A+, A-, B+, B-, AB+, AB-, O+, O-
  bloodPressure    String? // mmHg
  pulse            String? // bpm
  height           Float? // Cms
  weight           Float? // Kgs
  chest            Float? // Cms
  abdomen          Float? // Cms
  identificationMark String?
  spectaclesDetails String?
  dentalDetails    String?

  // Examination details
  majorIllness     String?
  operationAccident String?
  specialReport    String?
  doctorName       String?
  medicalExaminationDate DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  medicalHistory  MedicalHistory @relation(fields: [medicalHistoryId], references: [id], onDelete: Cascade)
}

